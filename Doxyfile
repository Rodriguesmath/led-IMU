#---------------------------------------------------------------------------
# Project related configuration options
#---------------------------------------------------------------------------

# O nome do seu projeto que aparecerá no topo de todas as páginas HTML.
PROJECT_NAME           = "Projeto RTOS - Atividade 09"

# A versão atual do desenvolvimento do seu firmware.
PROJECT_NUMBER         = "1.0"

# Pasta onde toda a estrutura de páginas web (HTML) será gerada.
OUTPUT_DIRECTORY       = docs

# Define o idioma padrão da estrutura e das mensagens estáticas da página.
OUTPUT_LANGUAGE        = Brazilian

# Otimiza a saída do Doxygen para estruturar projetos puramente escritos em C.
OPTIMIZE_OUTPUT_FOR_C  = YES

#---------------------------------------------------------------------------
# Configuration options related to the input files
#---------------------------------------------------------------------------

# Mapeia as duas novas pastas do seu projeto para que o Doxygen busque os códigos.
INPUT                  = main/src main/inc

# Garante que o filtro do Doxygen verifique todas as subpastas de forma recursiva.
RECURSIVE              = YES

#---------------------------------------------------------------------------
# Configuration options related to diagram generator tools
#---------------------------------------------------------------------------

# ATENÇÃO: Mudado de NO para YES. Ativa o motor gráfico do Graphviz que você instalou.
HAVE_DOT               = YES

# Permite que o Doxygen use múltiplos núcleos do seu processador para gerar os gráficos mais rápido.
DOT_NUM_THREADS        = 0

# Gera um gráfico mostrando quais arquivos dão #include em quais cabeçalhos.
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES

# Gera um diagrama de fluxo mostrando quais funções chamam quais sub-rotinas no código.
CALL_GRAPH             = YES
CALLER_GRAPH           = YES